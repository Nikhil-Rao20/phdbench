  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && gh-pages -d dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "shoot": "node scripts/shoot.mjs",
